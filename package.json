{
  "name": "patch-transfer",
  "displayName": "Patch Transfer",
  "description": "Safely create, transfer, inspect, apply, and roll back code patches across offline and air-gapped VS Code environments.",
  "version": "0.1.0",
  "publisher": "Alicanyayl",
  "license": "MIT",
  "pricing": "Free",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1f1f1f",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alicanyayl/vscode-patch-transfer.git"
  },
  "homepage": "https://github.com/alicanyayl/vscode-patch-transfer#readme",
  "bugs": {
    "url": "https://github.com/alicanyayl/vscode-patch-transfer/issues"
  },
  "keywords": [
    "offline",
    "air-gapped",
    "patch",
    "git",
    "transfer",
    "deployment",
    "secure",
    "diff",
    "rollback",
    "conflict",
    "disconnected",
    "source-control"
  ],
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "engines": {
    "vscode": "^1.134.0"
  },
  "extensionDependencies": [
    "vscode.git"
  ],
  "activationEvents": [
    "onView:patch-transfer.changes",
    "onView:patch-transfer.patches",
    "onCommand:patch-transfer.refresh",
    "onCommand:patch-transfer.refreshPatches",
    "onCommand:patch-transfer.createPatch",
    "onCommand:patch-transfer.importPatch",
    "onCommand:patch-transfer.setTransferFolder",
    "onCommand:patch-transfer.previewPatch",
    "onCommand:patch-transfer.applyPatch",
    "onCommand:patch-transfer.showPatchError",
    "onCommand:patch-transfer.undoLastPatch",
    "onCommand:patch-transfer.showConflictDetails",
    "onCommand:patch-transfer.copyConflictDiagnostics",
    "onCommand:patch-transfer.showHistory",
    "onCommand:patch-transfer.showPatchDetails"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "patch-transfer.createPatch",
        "title": "Create Patch",
        "icon": "$(file-add)"
      },
      {
        "command": "patch-transfer.refresh",
        "title": "Refresh Changes",
        "icon": "$(refresh)"
      },
      {
        "command": "patch-transfer.refreshPatches",
        "title": "Refresh Patches",
        "icon": "$(refresh)"
      },
      {
        "command": "patch-transfer.importPatch",
        "title": "Import Patch",
        "icon": "$(file-add)"
      },
      {
        "command": "patch-transfer.setTransferFolder",
        "title": "Set Transfer Folder",
        "category": "Patch Transfer",
        "icon": "$(folder-opened)"
      },
      {
        "command": "patch-transfer.applyPatch",
        "title": "Apply this patch to the current project",
        "shortTitle": "Apply Patch",
        "category": "Patch Transfer",
        "icon": "$(play)",
        "enablement": "patchTransfer.patchReady"
      },
      {
        "command": "patch-transfer.previewPatch",
        "title": "Preview patch changes",
        "shortTitle": "Preview Patch",
        "category": "Patch Transfer",
        "icon": "$(eye)"
      },
      {
        "command": "patch-transfer.showPatchError",
        "title": "Show Patch Error",
        "icon": "$(output)",
        "enablement": "patchTransfer.patchHasError"
      },
      {
        "command": "patch-transfer.undoLastPatch",
        "title": "Undo Last Patch",
        "shortTitle": "Undo Last Patch",
        "category": "Patch Transfer",
        "icon": "$(discard)"
      },
      {
        "command": "patch-transfer.showConflictDetails",
        "title": "Show Conflict Details",
        "shortTitle": "Conflict Details",
        "category": "Patch Transfer",
        "icon": "$(issues)"
      },
      {
        "command": "patch-transfer.copyConflictDiagnostics",
        "title": "Copy Conflict Diagnostics",
        "category": "Patch Transfer"
      },
      {
        "command": "patch-transfer.showHistory",
        "title": "Show History",
        "shortTitle": "History",
        "category": "Patch Transfer",
        "icon": "$(history)"
      },
      {
        "command": "patch-transfer.showPatchDetails",
        "title": "Show Patch Details",
        "shortTitle": "Patch Details",
        "category": "Patch Transfer",
        "icon": "$(info)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "patch-transfer",
          "title": "Patch Transfer",
          "icon": "media/patch-transfer.svg"
        }
      ]
    },
    "views": {
      "patch-transfer": [
        {
          "id": "patch-transfer.changes",
          "name": "Changes",
          "type": "webview"
        },
        {
          "id": "patch-transfer.patches",
          "name": "Patches"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "patch-transfer.createPatch",
          "when": "view == patch-transfer.changes",
          "group": "navigation@1"
        },
        {
          "command": "patch-transfer.refresh",
          "when": "view == patch-transfer.changes",
          "group": "navigation@2"
        },
        {
          "command": "patch-transfer.setTransferFolder",
          "when": "view == patch-transfer.changes",
          "group": "navigation@3"
        },
        {
          "command": "patch-transfer.importPatch",
          "when": "view == patch-transfer.patches",
          "group": "navigation@1"
        },
        {
          "command": "patch-transfer.refreshPatches",
          "when": "view == patch-transfer.patches",
          "group": "navigation@2"
        },
        {
          "command": "patch-transfer.setTransferFolder",
          "when": "view == patch-transfer.patches",
          "group": "navigation@3"
        },
        {
          "command": "patch-transfer.undoLastPatch",
          "when": "view == patch-transfer.patches",
          "group": "navigation@4"
        },
        {
          "command": "patch-transfer.showHistory",
          "when": "view == patch-transfer.patches",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "patch-transfer.previewPatch",
          "when": "view == patch-transfer.patches && (viewItem == patchTransfer.patch.ready || viewItem == patchTransfer.patch.conflict || viewItem == patchTransfer.patch.created || viewItem == patchTransfer.patch.applied || viewItem == patchTransfer.patch.applied.undoable)",
          "group": "inline@1"
        },
        {
          "command": "patch-transfer.applyPatch",
          "when": "view == patch-transfer.patches && viewItem == patchTransfer.patch.ready",
          "group": "inline@2"
        },
        {
          "command": "patch-transfer.showConflictDetails",
          "when": "view == patch-transfer.patches && viewItem == patchTransfer.patch.conflict",
          "group": "inline@2"
        },
        {
          "command": "patch-transfer.showPatchError",
          "when": "view == patch-transfer.patches && viewItem == patchTransfer.patch.invalid",
          "group": "inline@1"
        },
        {
          "command": "patch-transfer.showPatchDetails",
          "when": "view == patch-transfer.patches && (viewItem == patchTransfer.patch.ready || viewItem == patchTransfer.patch.conflict || viewItem == patchTransfer.patch.created || viewItem == patchTransfer.patch.applied || viewItem == patchTransfer.patch.applied.undoable)",
          "group": "2_details"
        },
        {
          "command": "patch-transfer.undoLastPatch",
          "when": "view == patch-transfer.patches && viewItem == patchTransfer.patch.applied.undoable",
          "group": "inline@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.134.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}